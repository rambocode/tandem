---
import Logo from './Logo.astro';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { promotion } from '../i18n/promotion';
import { LINKS, SITE } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = promotion[lang];
const home = localizePath('/', lang);
const linkGroups = [
  [`${home}#toolkit`, `${home}#pro`, localizePath('/changelog/', lang), localizePath('/blog/', lang), LINKS.macDownload],
  [`${home}#faq`, localizePath('/compare/', lang), localizePath('/privacy/', lang), localizePath('/terms/', lang)],
  [localizePath('/', 'zh'), localizePath('/', 'en'), localizePath('/', 'ja')],
];
const changelogHref = localizePath('/changelog/', lang);
const year = 2026; // Date.now() 在构建沙箱不可用，固定当前年份
---

<footer class="ft">
  <div class="container ft-inner">
    <div class="ft-brand">
      <Logo size={24} withWordmark />
      <p class="ft-tag">{t.footer.tagline}</p>
    </div>
    <div class="ft-groups">
      {
        t.footer.groups.map((group, groupIndex) => (
          <nav class="ft-nav" aria-label={group.title}>
            <span class="ft-h">{group.title}</span>
            {group.links.map((label, linkIndex) => <a href={linkGroups[groupIndex]?.[linkIndex] ?? home}>{label}</a>)}
          </nav>
        ))
      }
    </div>
  </div>
  <div class="container ft-bottom">
    <span>© {year} {SITE.name} · {t.footer.closing}</span>
    <a class="ft-version" href={changelogHref}>{SITE.versionLine}</a>
  </div>
</footer>

<style>
  .ft {
    background: rgba(255, 255, 255, 0.58);
    border-top: 1px solid var(--sep);
    padding-block: 44px 28px;
  }
  .ft-inner {
    display: grid;
    grid-template-columns: 1.1fr 1.9fr;
    gap: clamp(44px, 8vw, 110px);
  }
  .ft-tag {
    margin-top: 12px;
    color: var(--text-2);
    font-size: 0.9rem;
    max-width: 38ch;
  }
  .ft-nav {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 0.92rem;
    color: var(--text-2);
  }
  .ft-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(26px, 5vw, 72px);
  }
  .ft-h {
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 2px;
  }
  .ft-nav a:hover {
    color: var(--text-1);
  }
  .ft-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--sep);
    font-size: 0.82rem;
    color: var(--text-3);
  }
  .ft-version {
    font-family: var(--font-round);
    color: inherit;
  }
  .ft-version:hover {
    color: var(--text-1);
  }
  @media (max-width: 760px) {
    .ft-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .ft-groups { grid-template-columns: repeat(2, 1fr); }
  }
</style>
