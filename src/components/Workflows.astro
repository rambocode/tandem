---
import { promotion } from '../i18n/promotion';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = promotion[lang];
---

<section id="workflows" class="section workflows">
  <div class="container">
    <header class="section-head">
      <h2 class="section-title">{t.workflows.heading}</h2>
      <p class="section-lead">{t.workflows.lead}</p>
    </header>

    <ol class="workflow-grid">
      {
        t.workflows.items.map((item, index) => (
          <li class="workflow-item">
            <div class="workflow-copy">
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
            <div class:list={['workflow-visual', `workflow-visual-${index + 1}`]} aria-hidden="true">
              {index === 0 && (
                <>
                  <div class="mini-mac"><b>Q2</b><i></i><i></i><small>{t.toolkit.visual.copied}</small></div>
                  <span class="mini-rail"></span>
                  <div class="mini-phone"><i></i><i></i><i></i><b>↑</b></div>
                </>
              )}
              {index === 1 && (
                <>
                  <div class="capture-card"><span></span><span></span><i>↗</i></div>
                  <span class="mini-rail"></span>
                  <div class="sync-card"><b>✓</b><small>{t.toolkit.visual.synced}</small></div>
                </>
              )}
              {index === 2 && (
                <div class="tool-menu"><i>⌖</i><span>OCR</span><span>↕</span><span>●</span><span>GIF</span></div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section-head { max-width: 760px; }
  .section-title { margin-top: 0; }
  .workflow-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 42px);
    margin-top: clamp(46px, 6vw, 72px);
  }
  .workflow-grid::before {
    content: '';
    position: absolute;
    left: 4%;
    right: 4%;
    top: 198px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(109, 91, 255, 0.48), rgba(52, 199, 89, 0.48), transparent);
    box-shadow: 0 0 12px rgba(109, 91, 255, 0.24);
  }
  .workflow-item { min-width: 0; }
  .workflow-copy {
    min-height: 132px;
    border-top: 1px solid var(--sep-strong);
    padding-top: 18px;
  }
  .workflow-copy span {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--brand-1);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .workflow-copy h3 {
    margin-top: 15px;
    font-size: 1.15rem;
  }
  .workflow-copy p {
    margin-top: 7px;
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .workflow-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 26px 10px 0;
  }
  .mini-mac,
  .capture-card,
  .sync-card {
    position: relative;
    z-index: 1;
    border: 1px solid var(--sep-strong);
    background: var(--surface);
    box-shadow: 0 18px 36px -26px rgba(0, 0, 0, 0.5);
  }
  .mini-mac {
    width: 136px;
    height: 146px;
    border-radius: 12px;
    padding: 25px 14px 12px;
  }
  .mini-mac::before,
  .capture-card::before {
    content: '•••';
    position: absolute;
    top: 7px;
    left: 10px;
    color: #ff6b5f;
    letter-spacing: 2px;
    font-size: 0.6rem;
  }
  .mini-mac i {
    display: block;
    width: 86%;
    height: 6px;
    margin-top: 12px;
    border-radius: 3px;
    background: var(--surface-3);
  }
  .mini-mac i:nth-of-type(2) { width: 62%; }
  .mini-mac small {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: 3px 7px;
    border: 1px solid var(--sep);
    border-radius: 5px;
    color: var(--text-2);
    font-size: 0.62rem;
  }
  .mini-phone {
    position: relative;
    z-index: 1;
    width: 78px;
    height: 158px;
    margin-left: 28px;
    padding: 38px 10px 12px;
    border: 5px solid #18181b;
    border-radius: 22px;
    background: var(--surface);
  }
  .mini-phone::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 50%;
    width: 28px;
    height: 7px;
    border-radius: 8px;
    background: #111;
    transform: translateX(-50%);
  }
  .mini-phone i {
    display: block;
    height: 13px;
    margin-bottom: 6px;
    border-radius: 4px;
    background: var(--surface-3);
  }
  .mini-phone b {
    display: grid;
    place-items: center;
    width: 30px;
    height: 24px;
    margin: 15px auto 0;
    border-radius: 7px;
    background: var(--brand-1);
    color: #fff;
  }
  .mini-rail {
    position: absolute;
    z-index: 0;
    width: 48%;
    height: 2px;
    background: var(--brand-1);
    box-shadow: 0 0 12px rgba(109, 91, 255, 0.46);
  }
  .capture-card {
    width: 156px;
    height: 150px;
    border-radius: 12px;
    padding: 36px 18px;
  }
  .capture-card span {
    display: block;
    width: 90%;
    height: 25px;
    margin-bottom: 10px;
    border-radius: 4px;
    background: rgba(109, 91, 255, 0.2);
  }
  .capture-card span:nth-child(2) { width: 62%; }
  .capture-card i {
    position: absolute;
    right: 18px;
    bottom: 18px;
    color: var(--brand-1);
    font-style: normal;
    font-size: 2.2rem;
  }
  .sync-card {
    display: grid;
    place-items: center;
    gap: 6px;
    width: 98px;
    height: 126px;
    margin-left: 34px;
    border-radius: 18px;
  }
  .sync-card b { color: var(--green); font-size: 1.8rem; }
  .sync-card small { padding: 0 8px; text-align: center; color: var(--text-2); }
  .tool-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px;
    border-radius: 14px;
    background: #202026;
    box-shadow: 0 22px 42px -20px rgba(0, 0, 0, 0.58);
  }
  .tool-menu > * {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding-inline: 8px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 0.72rem;
    font-style: normal;
  }
  .tool-menu i { background: var(--brand-1); }
  @media (max-width: 840px) {
    .workflow-grid { grid-template-columns: 1fr; }
    .workflow-grid::before { display: none; }
    .workflow-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.9fr);
      gap: 24px;
      align-items: center;
    }
  }
  @media (max-width: 620px) {
    .workflow-item { grid-template-columns: 1fr; }
    .workflow-copy { min-height: 0; }
    .workflow-visual { min-height: 190px; }
  }
</style>
