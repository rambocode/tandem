---
import type { MarkdownHeading } from 'astro';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BlogVisual from './BlogVisual.astro';
import { blogStrings } from '../i18n/blog';
import { type BlogPost, blogIndexPath, blogPostPath, formatPostDate, getAllBlogPosts, publishedPosts } from '../lib/blog';
import { SITE } from '../config';

interface Props {
  lang: BlogPost['data']['lang'];
  post: BlogPost;
  headings: MarkdownHeading[];
}

const { lang, post, headings } = Astro.props;
const t = blogStrings[lang];
const allPosts = await getAllBlogPosts();
const languagePosts = publishedPosts(allPosts, lang);
const recommendations = languagePosts.filter((candidate) => candidate.id !== post.id).slice(0, 2);
const alternates = allPosts
  .filter((candidate) => !candidate.data.draft && candidate.data.permalink === post.data.permalink)
  .map((candidate) => candidate.data.lang);
const toc = headings.filter((heading) => heading.depth === 2);
const canonical = new URL(blogPostPath(post), SITE.domain).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: lang === 'zh' ? 'zh-Hans' : lang,
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: canonical,
};
---

<Base
  lang={lang}
  path={`/blog/${post.data.permalink}/`}
  title={`${post.data.title} — Tandem`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  structuredData={structuredData}
  alternateLangs={alternates}
>
  <Header lang={lang} languagePath="/blog/" />
  <main class="post">
    <article class="container post-shell">
      <header class="post-head">
        <p class="breadcrumbs"><a href={blogIndexPath(lang)}>{t.breadcrumb}</a><span>/</span>{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="post-deck">{post.data.description}</p>
        <p class="post-meta">{formatPostDate(post.data.publishedAt, lang)} · {t.minuteRead(post.data.readingMinutes)}</p>
      </header>

      <div class="post-layout">
        <div class="post-main">
          <BlogVisual kind="capture" />
          <div class="article-body"><slot /></div>
        </div>
        {
          toc.length > 0 && (
            <aside class="toc" aria-label={t.contents}>
              <strong>{t.contents}</strong>
              <ul>
                {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
              </ul>
            </aside>
          )
        }
      </div>

      {
        recommendations.length > 0 && (
          <section class="continue" aria-labelledby="continue-title">
            <h2 id="continue-title">{t.continueReading}</h2>
            <ul>
              {recommendations.map((candidate) => (
                <li>
                  <a href={blogPostPath(candidate)}>
                    <span>{candidate.data.title}</span>
                    <small>{formatPostDate(candidate.data.publishedAt, lang)} · {t.minuteRead(candidate.data.readingMinutes)}</small>
                    <i aria-hidden="true">→</i>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

    </article>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .post { padding-block: clamp(54px, 8vw, 96px) 110px; }
  .post-shell { max-width: 1120px; }
  .post-head { max-width: 920px; }
  .breadcrumbs { display: flex; gap: 9px; color: var(--brand-1); font-size: 0.82rem; font-weight: 750; }
  .breadcrumbs span { color: var(--text-3); }
  .post-head h1 { max-width: 22ch; margin-top: 22px; font-size: clamp(2.8rem, 5vw, 4.25rem); letter-spacing: -0.04em; }
  .post-deck { max-width: 70ch; margin-top: 20px; color: var(--text-2); font-size: clamp(1.05rem, 1.7vw, 1.25rem); }
  .post-meta { margin-top: 17px; color: var(--text-3); font-size: 0.88rem; }
  .post-layout { display: grid; grid-template-columns: minmax(0, 820px) minmax(150px, 210px); gap: clamp(36px, 6vw, 72px); margin-top: 50px; }
  .post-main :global(.blog-visual) { min-height: 420px; }
  .toc { position: sticky; top: 94px; align-self: start; padding-top: 4px; }
  .toc strong { font-family: var(--font-round); font-size: 0.88rem; }
  .toc ul { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
  .toc li { color: var(--brand-1); font-size: 0.82rem; line-height: 1.45; }
  .toc a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .article-body { max-width: 760px; margin-top: 42px; }
  .article-body :global(p) { margin-top: 20px; color: var(--text-2); font-size: 1.04rem; line-height: 1.85; }
  .article-body :global(h2) { scroll-margin-top: 90px; margin-top: 42px; padding-top: 30px; border-top: 1px solid var(--sep); font-size: clamp(1.45rem, 3vw, 1.9rem); }
  .article-body :global(blockquote) { margin: 34px 0 0; padding: 18px 20px; border: 0; border-radius: 9px; background: linear-gradient(90deg, rgba(109, 91, 255, 0.13), rgba(177, 75, 244, 0.06)); color: var(--brand-1); }
  .article-body :global(blockquote p) { margin: 0; color: inherit; font-weight: 700; }
  .continue { max-width: 820px; margin-top: 64px; padding-block: 30px; border-top: 1px solid var(--sep-strong); }
  .continue h2 { font-size: 1.35rem; }
  .continue ul { margin-top: 16px; }
  .continue li { border-top: 1px solid var(--sep); }
  .continue li:last-child { border-bottom: 1px solid var(--sep); }
  .continue a { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 20px; padding-block: 16px; }
  .continue a > span { color: var(--brand-1); font-weight: 750; }
  .continue small { color: var(--text-3); }
  .continue i { font-style: normal; }
  @media (max-width: 880px) {
    .post-layout { grid-template-columns: 1fr; }
    .toc { display: none; }
  }
  @media (max-width: 620px) {
    .post-head h1 { font-size: clamp(2.55rem, 13vw, 3.8rem); }
    .post-main :global(.blog-visual) { min-height: 280px; }
    .continue a { grid-template-columns: 1fr auto; }
    .continue small { grid-row: 2; }
  }
</style>
