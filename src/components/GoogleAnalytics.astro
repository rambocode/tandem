---
const rawMeasurementId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
const measurementId = rawMeasurementId?.toUpperCase();
const enabled = Boolean(measurementId);

// GA4 Measurement ID 必须以 G- 开头。配置错误时让构建明确失败，避免部署后静默丢失数据。
if (measurementId && !/^G-[A-Z0-9]{4,}$/.test(measurementId)) {
  throw new Error('PUBLIC_GOOGLE_ANALYTICS_ID must be a valid GA4 Measurement ID such as G-XXXXXXXXXX.');
}
---

{
  enabled && (
    <>
      {/* Google tag 按官方顺序全站直接加载，不展示站内授权弹窗。 */}
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
      <script is:inline define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', measurementId);

        /** 只统计官网的关键转化入口，避免把普通站内导航变成冗余自定义事件。 */
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a[href]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const url = new URL(link.href, window.location.href);
          let eventName = null;
          if (url.hostname === 'github.com' && url.pathname.includes('/rambocode/tandem/releases')) {
            eventName = 'mac_download_click';
          } else if (url.hostname === 'apps.apple.com') {
            eventName = 'ios_app_store_click';
          } else if (url.pathname.endsWith('/rss.xml')) {
            eventName = 'rss_subscribe';
          }

          if (eventName) {
            window.gtag('event', eventName, {
              link_url: url.href,
              transport_type: 'beacon',
            });
          }
        });
      </script>
    </>
  )
}
