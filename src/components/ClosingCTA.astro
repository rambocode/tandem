---
import { promotion } from '../i18n/promotion';
import type { Lang } from '../i18n/ui';
import { LINKS } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = promotion[lang];
---

<section class="closing-wrap">
  <div class="container">
    <div class="closing">
      <div class="closing-route" aria-hidden="true">
        <span class="route-lock">▢</span>
        <i></i>
        <span class="route-mac">▱</span>
        <i></i>
        <span class="route-phone">▯</span>
      </div>
      <h2>{t.closing.heading}</h2>
      <p>{t.closing.lead}</p>
      <div class="closing-actions">
        <a href={LINKS.macDownload} class="btn btn-primary">{t.closing.macCta}</a>
        <a href={LINKS.appStore} class="btn closing-ios">{t.closing.iosCta}</a>
      </div>
      <small>{t.closing.note}</small>
    </div>
  </div>
</section>

<style>
  .closing-wrap { padding-block: 24px clamp(72px, 8vw, 110px); }
  .closing {
    position: relative;
    overflow: hidden;
    padding: clamp(74px, 8vw, 112px) clamp(20px, 6vw, 72px) clamp(54px, 7vw, 82px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: radial-gradient(circle at 50% 0%, #272b39, #111217 62%);
    color: #fff;
    text-align: center;
  }
  .closing-route {
    position: absolute;
    top: 24px;
    left: 50%;
    display: grid;
    grid-template-columns: 70px minmax(80px, 180px) 54px minmax(80px, 180px) 70px;
    align-items: center;
    width: min(78%, 660px);
    transform: translateX(-50%);
    color: #8a80ff;
  }
  .closing-route i {
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    box-shadow: 0 0 10px currentColor;
  }
  .closing-route span {
    font-size: 2.2rem;
    line-height: 1;
  }
  .route-lock {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-inline: auto;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.1rem !important;
  }
  .closing h2 {
    max-width: 820px;
    margin-inline: auto;
    font-size: clamp(2.25rem, 4.6vw, 4.2rem);
    letter-spacing: -0.04em;
  }
  .closing p {
    max-width: 620px;
    margin: 17px auto 0;
    color: rgba(255, 255, 255, 0.6);
  }
  .closing-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .closing .btn-primary {
    background: var(--brand-grad);
    box-shadow: 0 18px 36px -18px rgba(109, 91, 255, 0.9);
  }
  .closing-ios {
    border-color: rgba(255, 255, 255, 0.48);
    background: transparent;
    color: #fff;
  }
  .closing small {
    display: block;
    margin-top: 15px;
    color: rgba(255, 255, 255, 0.42);
  }
  @media (max-width: 620px) {
    .closing-route {
      grid-template-columns: 44px 1fr 40px 1fr 44px;
      width: 88%;
    }
    .closing-route span { font-size: 1.6rem; }
    .route-lock { width: 38px; height: 38px; font-size: 0.8rem !important; }
  }
</style>
