---
import { promotion } from '../i18n/promotion';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = promotion[lang];
---

<section id="privacy" class="section privacy">
  <div class="container privacy-inner">
    <header class="privacy-head">
      <h2>{t.privacy.heading}</h2>
      <p>{t.privacy.lead}</p>
    </header>

    <div class="privacy-route" aria-label={t.privacy.lead}>
      <div class="device device-mac">
        <span class="mac-screen"><i></i><i></i><i></i></span>
        <strong>{t.privacy.mac}</strong>
      </div>
      <div class="encrypted-route route-left" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="relay">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9a10 10 0 0 1 14 0M8 12a6 6 0 0 1 8 0M11 15a2 2 0 0 1 2 0" /></svg>
        <strong>{t.privacy.relay}</strong>
        <span>⌾ {t.privacy.encrypted}</span>
      </div>
      <div class="encrypted-route route-right" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="device device-phone">
        <span class="phone-screen"><i></i><i></i><i></i></span>
        <strong>{t.privacy.iphone}</strong>
      </div>
      <div class="cloud-bypass">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M8 24h15a6 6 0 0 0 1-11.9A8 8 0 0 0 9.3 10" /><path d="m5 5 22 22" /></svg>
        <span>{t.privacy.bypass}</span>
      </div>
    </div>

    <ul class="privacy-points">
      {
        t.privacy.points.map((point, index) => (
          <li>
            <span class="point-number">0{index + 1}</span>
            <div><strong>{point.title}</strong><p>{point.description}</p></div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .privacy {
    margin: clamp(12px, 2vw, 28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: radial-gradient(circle at 50% 35%, #242733, #121318 68%);
    color: #fff;
    overflow: hidden;
  }
  .privacy-inner { max-width: 1240px; }
  .privacy-head { max-width: 780px; }
  .privacy-head h2 {
    font-size: clamp(2.2rem, 4.4vw, 3.5rem);
    letter-spacing: -0.035em;
  }
  .privacy-head p {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.65);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
  }
  .privacy-route {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(60px, 0.7fr) 1.1fr minmax(60px, 0.7fr) 1fr;
    align-items: center;
    gap: 14px;
    min-height: 350px;
    margin-top: 44px;
  }
  .device {
    display: grid;
    justify-items: center;
    gap: 16px;
  }
  .device strong,
  .relay strong { font-size: 0.92rem; }
  .mac-screen {
    position: relative;
    display: grid;
    gap: 10px;
    width: 170px;
    height: 108px;
    padding: 30px 18px 16px;
    border: 2px solid rgba(255, 255, 255, 0.72);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
  }
  .mac-screen::after {
    content: '';
    position: absolute;
    right: 32px;
    bottom: -12px;
    left: 32px;
    height: 2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 7px 0 -1px rgba(255, 255, 255, 0.36);
  }
  .mac-screen i,
  .phone-screen i {
    display: block;
    height: 9px;
    border-radius: 3px;
    background: rgba(109, 91, 255, 0.65);
  }
  .mac-screen i:nth-child(2) { width: 66%; }
  .mac-screen i:nth-child(3) { width: 82%; background: rgba(52, 199, 89, 0.54); }
  .phone-screen {
    display: grid;
    gap: 10px;
    width: 78px;
    height: 150px;
    padding: 35px 11px 12px;
    border: 4px solid rgba(255, 255, 255, 0.75);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
  }
  .phone-screen i:nth-child(2) { background: rgba(52, 199, 89, 0.62); }
  .encrypted-route {
    position: relative;
    height: 2px;
    background: linear-gradient(90deg, transparent, #7769ff, #68da85, transparent);
    box-shadow: 0 0 14px rgba(109, 91, 255, 0.72);
  }
  .encrypted-route i {
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 9px #7769ff;
    animation: privacyTravel 3s ease-in-out infinite;
  }
  .encrypted-route i:nth-child(2) { animation-delay: 1s; }
  .encrypted-route i:nth-child(3) { animation-delay: 2s; }
  @keyframes privacyTravel {
    0% { left: 0; opacity: 0; }
    15%, 85% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  .relay {
    display: grid;
    justify-items: center;
    gap: 9px;
    padding: 28px 16px;
    border: 1px solid rgba(52, 199, 89, 0.7);
    border-radius: 18px;
    background: rgba(27, 31, 31, 0.84);
    box-shadow: 0 0 38px rgba(52, 199, 89, 0.13);
    text-align: center;
  }
  .relay svg {
    width: 34px;
    fill: none;
    stroke: var(--green);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .relay span { color: var(--green); font-size: 0.72rem; }
  .cloud-bypass {
    position: absolute;
    top: 2px;
    right: 16%;
    display: grid;
    justify-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.42);
  }
  .cloud-bypass svg {
    width: 48px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .cloud-bypass span { font-size: 0.7rem; }
  .privacy-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }
  .privacy-points li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    min-height: 130px;
    padding: 28px clamp(16px, 3vw, 34px);
    border-left: 1px solid rgba(255, 255, 255, 0.13);
  }
  .privacy-points li:last-child { border-right: 1px solid rgba(255, 255, 255, 0.13); }
  .point-number { color: #897eff; font-size: 0.74rem; font-weight: 800; }
  .privacy-points strong { font-size: 0.98rem; }
  .privacy-points p { margin-top: 6px; color: rgba(255, 255, 255, 0.54); font-size: 0.8rem; }
  @media (max-width: 820px) {
    .privacy-route {
      grid-template-columns: 1fr 80px 1fr;
      min-height: 520px;
    }
    .relay { grid-column: 2; grid-row: 1; }
    .device-mac { grid-column: 1; grid-row: 2; }
    .device-phone { grid-column: 3; grid-row: 2; }
    .route-left { grid-column: 1 / 2; grid-row: 2; }
    .route-right { grid-column: 2 / 4; grid-row: 2; }
    .cloud-bypass { top: 44px; right: 2%; }
  }
  @media (max-width: 680px) {
    .privacy { margin-inline: 10px; }
    .privacy-route { min-height: 450px; }
    .mac-screen { width: 128px; height: 86px; }
    .privacy-points { grid-template-columns: 1fr; }
    .privacy-points li {
      min-height: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.13);
      border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    }
  }
</style>
