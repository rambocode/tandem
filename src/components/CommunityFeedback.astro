---
import Comments from './Comments.astro';
import type { Lang } from '../i18n/ui';
import { blogStrings } from '../i18n/blog';
import { LINKS } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = blogStrings[lang].feedback;
---

<section id="feedback" class="feedback section" aria-labelledby="feedback-title">
  <div class="container feedback-grid">
    <div class="feedback-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="feedback-title">{t.title}</h2>
      <p>{t.lead}</p>
      <a href={LINKS.appStore} target="_blank" rel="noreferrer">{t.appStore} →</a>
    </div>
    <Comments lang={lang} />
  </div>
</section>

<style>
  .feedback { border-top: 1px solid var(--sep); }
  .feedback-grid { display: grid; grid-template-columns: minmax(260px, 0.7fr) minmax(420px, 1.3fr); gap: clamp(44px, 8vw, 112px); align-items: start; }
  .feedback-copy h2 { max-width: 13ch; margin-top: 14px; font-size: clamp(2.15rem, 4vw, 3.4rem); }
  .feedback-copy > p:not(.eyebrow) { max-width: 46ch; margin-top: 18px; color: var(--text-2); }
  .feedback-copy a { display: inline-block; margin-top: 22px; color: var(--brand-1); font-weight: 750; }
  .feedback :global(.discussion) { padding-top: 0; border-top: 0; }
  @media (max-width: 820px) {
    .feedback-grid { grid-template-columns: 1fr; }
    .feedback-copy h2 { max-width: 18ch; }
  }
</style>
