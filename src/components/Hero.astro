---
import MacMockup from './MacMockup.astro';
import PhoneMockup from './PhoneMockup.astro';
import { promotion } from '../i18n/promotion';
import type { Lang } from '../i18n/ui';
import { LINKS } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = promotion[lang];
const titleLines = t.hero.title.split('\n');
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">
        {titleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </h1>
      <p class="hero-description">{t.hero.description}</p>
      <div class="hero-actions">
        <a href={LINKS.macDownload} class="btn btn-primary">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" /></svg>
          {t.hero.macCta}
        </a>
        <a href={LINKS.appStore} class="hero-ios">{t.hero.iosCta}<span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-note">{t.hero.note}</p>
    </div>

    <div class="product-proof" aria-label="Tandem product preview">
      <div class="mac-layer"><MacMockup lang={lang} /></div>
      <div class="relay-rail" aria-hidden="true"><i class="relay-pulse"></i></div>
      <div class="phone-layer"><PhoneMockup lang={lang} /></div>
      <div class="editor-layer" aria-hidden="true">
        <div class="editor-bar">
          <span class="editor-dots"><i></i><i></i><i></i></span>
          <span>{t.hero.editorTitle}</span>
          <span>100%</span>
        </div>
        <div class="editor-canvas">
          <span class="editor-note">{t.hero.editorNote}</span>
          <span class="editor-arrow"></span>
          <div class="editor-chart">
            <i style="--w: 42%"></i><i style="--w: 64%"></i><i style="--w: 82%"></i>
          </div>
        </div>
        <div class="editor-tools"><span>↶</span><span>□</span><span>↗</span><span>T</span><span class="tool-color"></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(52px, 6vw, 78px) clamp(56px, 7vw, 92px);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    width: 560px;
    height: 560px;
    top: -260px;
    right: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(109, 91, 255, 0.12), transparent 68%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(480px, 1fr);
    align-items: center;
    gap: clamp(34px, 4vw, 56px);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .hero-title {
    font-size: clamp(3.2rem, 4.5vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
    word-break: keep-all;
    text-wrap: balance;
  }
  .hero-description {
    max-width: 45ch;
    margin-top: 26px;
    color: var(--text-2);
    font-size: clamp(1.04rem, 1.35vw, 1.2rem);
    line-height: 1.72;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }
  .hero-actions svg {
    width: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-ios {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--brand-1);
    font-family: var(--font-round);
    font-weight: 700;
  }
  .hero-ios span { transition: transform 0.18s ease; }
  .hero-ios:hover span { transform: translateX(4px); }
  .hero-note {
    margin-top: 20px;
    color: var(--text-3);
    font-size: 0.82rem;
  }
  .product-proof {
    position: relative;
    min-height: 620px;
    isolation: isolate;
  }
  .mac-layer {
    position: absolute;
    top: 54px;
    left: 0;
    z-index: 2;
  }
  .phone-layer {
    position: absolute;
    right: -6px;
    bottom: 4px;
    z-index: 3;
  }
  .editor-layer {
    position: absolute;
    left: 34px;
    bottom: 28px;
    z-index: 4;
    width: min(380px, 68%);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background: #202026;
    color: #fff;
    box-shadow: 0 30px 60px -26px rgba(0, 0, 0, 0.58);
    transform: rotate(-1.4deg);
  }
  .editor-bar,
  .editor-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding-inline: 13px;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.72rem;
  }
  .editor-dots { display: flex; gap: 5px; }
  .editor-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .editor-dots i:nth-child(2) { background: #febc2e; }
  .editor-dots i:nth-child(3) { background: #28c840; }
  .editor-canvas {
    position: relative;
    min-height: 210px;
    padding: 34px 28px;
    background:
      linear-gradient(rgba(109, 91, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(109, 91, 255, 0.06) 1px, transparent 1px),
      #fff;
    background-size: 28px 28px;
  }
  .editor-note {
    position: absolute;
    top: 20px;
    right: 24px;
    color: var(--brand-1);
    font-size: 0.8rem;
    font-weight: 700;
    transform: rotate(-2deg);
  }
  .editor-arrow {
    position: absolute;
    top: 58px;
    right: 70px;
    width: 72px;
    height: 56px;
    border-right: 4px solid var(--brand-1);
    border-bottom: 4px solid var(--brand-1);
    border-radius: 0 0 30px;
    transform: rotate(18deg);
  }
  .editor-arrow::after {
    content: '';
    position: absolute;
    right: -9px;
    bottom: -5px;
    width: 14px;
    height: 14px;
    border-right: 4px solid var(--brand-1);
    border-bottom: 4px solid var(--brand-1);
    transform: rotate(-45deg);
  }
  .editor-chart {
    display: grid;
    gap: 16px;
    width: 72%;
    margin-top: 62px;
  }
  .editor-chart i {
    display: block;
    width: var(--w);
    height: 13px;
    border-radius: 3px;
    background: linear-gradient(90deg, rgba(109, 91, 255, 0.46), rgba(109, 91, 255, 0.86));
  }
  .editor-tools {
    justify-content: flex-start;
    font-size: 0.9rem;
  }
  .tool-color {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand-1);
  }
  .relay-rail {
    position: absolute;
    top: 44%;
    left: 40%;
    right: 20%;
    z-index: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--brand-1), rgba(109, 91, 255, 0.26), var(--green));
    box-shadow: 0 0 14px rgba(109, 91, 255, 0.48);
  }
  .relay-rail::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 180px;
    background: linear-gradient(var(--green), rgba(52, 199, 89, 0));
  }
  .relay-pulse {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 5px rgba(109, 91, 255, 0.2), 0 0 18px var(--brand-1);
    animation: relayTravel 3.4s ease-in-out infinite;
  }
  @keyframes relayTravel {
    0% { left: 0; opacity: 0; }
    12%, 88% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { max-width: 760px; }
    .hero-description { max-width: 58ch; }
    .product-proof {
      width: min(100%, 660px);
      margin-inline: auto;
    }
  }
  @media (max-width: 620px) {
    .hero { padding-top: 52px; }
    .hero-title { font-size: clamp(2.7rem, 12vw, 4rem); }
    .product-proof {
      min-height: 500px;
      transform: scale(0.94);
      transform-origin: top center;
      margin-bottom: -30px;
    }
    .mac-layer { left: -18px; }
    .phone-layer { right: -16px; }
    .editor-layer { left: 0; width: 76%; }
  }
</style>
