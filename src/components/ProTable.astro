---
import { promotion } from '../i18n/promotion';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { LINKS } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = promotion[lang];
---

<section id="pro" class="section pro-section">
  <div class="container pro-grid">
    <div class="pro-offer">
      <h2 class="section-title">{t.pro.heading}</h2>
      <p class="section-lead">{t.pro.lead}</p>
      <p class="pro-label">{t.pro.label}</p>
      <p class="pro-price">{t.pro.price}</p>
      <p class="pro-note">{t.pro.priceNote}</p>
      <div class="pro-actions">
        <a href={LINKS.macDownload} class="btn btn-primary">{t.pro.macCta}</a>
        <a href={localizePath('/compare/', lang)} class="compare-link">{t.pro.compareCta}<span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="pro-table" role="table" aria-label={`${t.pro.free} / ${t.pro.pro}`}>
      <div class="pro-row pro-headrow" role="row">
        <span role="columnheader"></span>
        <strong role="columnheader">{t.pro.free}</strong>
        <strong role="columnheader" class="pro-column">{t.pro.pro}</strong>
      </div>
      {
        t.pro.rows.map((row) => (
          <div class="pro-row" role="row">
            <span role="rowheader">{row.feature}</span>
            <span role="cell">{row.free}</span>
            <strong role="cell" class="pro-column">{row.pro}</strong>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pro-section { border-bottom: 1px solid var(--sep); }
  .pro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(500px, 1.05fr);
    gap: clamp(44px, 5vw, 72px);
    align-items: center;
  }
  .pro-offer .section-title { margin-top: 0; }
  .pro-label {
    margin-top: 34px;
    font: 800 1.1rem var(--font-round);
  }
  .pro-price {
    margin-top: 3px;
    font: 800 clamp(3.6rem, 7vw, 5.4rem)/1 var(--font-round);
    letter-spacing: -0.055em;
  }
  .pro-note {
    margin-top: 12px;
    color: var(--text-2);
    font-size: 0.88rem;
  }
  .pro-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 28px;
  }
  .compare-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--brand-1);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .compare-link span { transition: transform 0.18s ease; }
  .compare-link:hover span { transform: translateX(4px); }
  .pro-table {
    overflow: hidden;
    border: 1px solid var(--sep-strong);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 58%, transparent);
  }
  .pro-row {
    display: grid;
    grid-template-columns: 1.1fr 0.8fr 0.8fr;
    align-items: stretch;
    border-top: 1px solid var(--sep);
  }
  .pro-row:first-child { border-top: none; }
  .pro-row > * {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 68px;
    padding: 14px 16px;
    border-left: 1px solid var(--sep);
    text-align: center;
    font-size: 0.88rem;
  }
  .pro-row > *:first-child {
    justify-content: flex-start;
    border-left: none;
    color: var(--text-2);
    text-align: left;
  }
  .pro-headrow > * {
    min-height: 58px;
    color: var(--text-1);
    font-family: var(--font-round);
  }
  .pro-column {
    color: var(--brand-1);
    background: rgba(109, 91, 255, 0.045);
  }
  @media (max-width: 940px) {
    .pro-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .pro-row { grid-template-columns: 1fr 76px 88px; }
    .pro-row > * { min-height: 62px; padding: 10px 8px; font-size: 0.78rem; }
  }
</style>
